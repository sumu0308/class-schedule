# ── 构建产物 ─────────────────────────────────────────────
build/
app/build/
*.apk
*.aab
*.log

# 项目根目录下的 Gradle 构建缓存（注意与下面 .gradle-home 区分：
# 那个是 Gradle 发行版与依赖缓存，这个是本项目的增量构建状态）
.gradle/
# Kotlin 编译器的增量编译缓存，构建时自动重建
.kotlin/

# ── 本项目的自包含运行环境（体积很大，绝不入库）────────────
# Android SDK：约 790 MB，由 tools/install-sdk-packages.mjs 重新生成
.android-sdk/
# Gradle 发行版与依赖缓存：约 1.7 GB，首次构建自动下载
.gradle-home/

# ── 本机相关配置 ─────────────────────────────────────────
# sdk.dir 是本机绝对路径，别人克隆后需要自己生成
local.properties
# 正式发布签名密钥（M6 阶段才引入）；调试密钥库 .keystore/ 是可入库的
keystore.properties
*.jks

# ── IDE ─────────────────────────────────────────────────
.idea/
*.iml
.DS_Store

# ── 临时文件 ─────────────────────────────────────────────
.gradle-home/_inspect/
.gradle-home/_innerjar/
.gradle-home/_wrappermerge/
*.tmp
